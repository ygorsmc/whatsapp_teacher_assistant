PROJECT_PREFIX := $(shell grep PROJECT_PREFIX global.env | cut -d '=' -f2 | tr -d '"')

ENV = dev
RG = $(PROJECT_PREFIX)-$(ENV)-rg
WS = $(PROJECT_PREFIX)-$(ENV)-ws
ENDPOINT_NAME = $(PROJECT_PREFIX)-ep-$(ENV)
PYTHONPATH_VAL = .

.PHONY: help permissions infra-up build-image index-standards train-pipeline \
        setup-compute-permissions deploy-canary env-gen run-app infra-down \
        test test-integration test-all validate-dataset generate-dataset \
        dev dev-api dev-frontend dev-worker

