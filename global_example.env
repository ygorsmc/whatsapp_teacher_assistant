ENVIRONMENT=development
LOG_LEVEL=INFO

# Meta / WhatsApp Webhook
META_APP_SECRET="sua_meta_app_secret_aqui"
META_VERIFY_TOKEN="seu_token_de_verificacao_aqui"
WHATSAPP_TOKEN="seu_token_de_acesso_temporario_ou_permanente_aqui"
PHONE_NUMBER_ID="seu_phone_number_id_aqui"
WHATSAPP_API_URL="https://graph.facebook.com/v25.0"
NGROK_URL="sua_url_ngrok_aqui_quando_rodando_localmente"

# Redis
REDIS_URL="redis://localhost:6379/0"
DEBOUNCE_TTL_SECONDS=2
MAX_BUFFER_CHARS=4096

# Service Bus
SERVICEBUS_FQDN="seu-namespace.servicebus.windows.net"
SERVICEBUS_CONNECTION_STRING="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Azure Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT="https://seu-recurso.cognitiveservices.azure.com/"
DOCUMENT_INTELLIGENCE_KEY="sua_chave_aqui"

# Providers Padrão
DEFAULT_LLM_PROVIDER="gemini"
DEFAULT_EMBEDDER_PROVIDER="azure"

# LLM API Keys
DEEPSEEK_API_KEY="sua_chave_deepseek_aqui"
GOOGLE_API_KEY="sua_chave_google_gemini_aqui"

# Database
DATABASE_URL="sqlite+aiosqlite:///./local_dev.db"

# Google Drive Sync
GOOGLE_DRIVE_FOLDER_ID="seu_folder_id_aqui"
GOOGLE_SHEET_ID="seu_sheet_id_aqui"

# Azure OpenAI / Embeddings
AZURE_OPENAI_API_KEY="sua_chave_azure_openai_aqui"
AZURE_OPENAI_ENDPOINT="https://seu-recurso.services.ai.azure.com"