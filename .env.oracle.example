# ============================================================================
# .env.oracle — perfil single-VM (Oracle Cloud Always Free / ARM A1)
# ----------------------------------------------------------------------------
#   cp .env.oracle.example .env.oracle   # e preencha o que está com <...>
# Cada linha é injetada como env var nos containers (env var > .env do app),
# então estes valores VENCEM qualquer .env que tenha ido junto na imagem.
# ============================================================================

ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Rede interna do compose (NÃO mexer: são os nomes dos serviços) ───────────
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
GOTENBERG_URL=http://gotenberg:3000
QUEUE_BACKEND=redis

# ── Postgres (a senha aparece em DOIS lugares — mantenha IDÊNTICAS) ──────────
POSTGRES_USER=whatsapp
POSTGRES_DB=whatsapp_assistant
POSTGRES_PASSWORD=<TROQUE_esta_senha_forte>
DATABASE_URL=postgresql+asyncpg://whatsapp:<TROQUE_esta_senha_forte>@postgres:5432/whatsapp_assistant

# ── Endpoint público via ngrok (default) ─────────────────────────────────────
# O agente ngrok disca pra fora (saída-only) — não abre porta na VM. O plano free
# dá 1 domínio ESTÁTICO (URL fixa mesmo sem domínio próprio). Em dashboard.ngrok.com:
# pegue o authtoken (Getting Started → Your Authtoken) e reserve o domínio grátis
# em Domains → Create Domain (gera algo tipo abc-123.ngrok-free.app).
NGROK_AUTHTOKEN=<seu_authtoken_ngrok>
NGROK_DOMAIN=<seu-dominio-estatico.ngrok-free.app>

# ── Alternativas de borda (opt-in por profile; NÃO precisa preencher pra ngrok) ─
# Cloudflare Tunnel (--profile cloudflare): grátis/ilimitado e sem abrir porta,
# mas exige domínio na conta Cloudflare (ex.: domínio grátis do GitHub Student Pack).
# TUNNEL_TOKEN=<token_do_cloudflare_tunnel>
# Caddy + Let's Encrypt (--profile caddy): domínio próprio, abre 80/443.
# WEBHOOK_DOMAIN=<bot.seudominio.com.br>
# ACME_EMAIL=<seu-email@dominio.com>

# ── Canal ATIVO: Telegram ────────────────────────────────────────────────────
CHANNEL_BACKEND=telegram
SCHEDULER_MODE=buttons
TELEGRAM_BOT_TOKEN=<token_do_botfather>
# Segredo que VOCÊ inventa; o MESMO valor vai no setWebhook (secret_token). O app
# rejeita POST cujo header X-Telegram-Bot-Api-Secret-Token não bata com ele.
TELEGRAM_WEBHOOK_SECRET=<invente_um_segredo_forte>

# ── WhatsApp (OPCIONAL — caminho pronto; preencha quando for ligar) ──────────
# Pra ativar: troque acima para CHANNEL_BACKEND=whatsapp e SCHEDULER_MODE=template,
# preencha o bloco abaixo e cadastre o webhook na Meta (MESMO túnel, rota
# /v1/webhook/whatsapp). Deixar os placeholders NÃO quebra a operação Telegram.
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
PHONE_NUMBER_ID=<seu_phone_number_id>
WHATSAPP_TOKEN=<seu_token_permanente>
META_VERIFY_TOKEN=<token_de_verificacao_que_voce_escolher>
META_APP_SECRET=<app_secret_do_meta>
BOOTSTRAP_ADMIN_PHONE=<seu_numero_admin_ex_5541999999999>

# ── LLM (Gemini — free tier serve pro dev/teste) ─────────────────────────────
DEFAULT_LLM_PROVIDER=gemini
GOOGLE_API_KEY=<sua_chave_google_gemini>

# ── Embeddings LOCAIS via Ollama (bge-m3, 1024d) ─────────────────────────────
# DIMENSIONS=1024 tem que casar com a coleção do Qdrant (senão a factory avisa
# de mismatch e a busca quebra).
DEFAULT_EMBEDDER_PROVIDER=ollama
EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMENSIONS=1024
QDRANT_COLLECTION=documents_bge1024

# ── Reranker: sem GPU no free tier ───────────────────────────────────────────
# 'none' = passthrough (funciona liso). Para ligar rerank managed, troque para
# 'cohere' e informe a chave (barato/rápido com rerank-v4.0-fast).
RERANKER_PROVIDER=none
# COHERE_API_KEY=<sua_chave_cohere>
# COHERE_RERANK_MODEL=rerank-v4.0-fast

# ── Fonte de material / cadastro ─────────────────────────────────────────────
# gdrive = precisa do service_account.json montado (já é montado no compose).
# Para testar SEM Google, troque os dois para local (usa data/materials e data/registry).
MATERIAL_SOURCE_BACKEND=gdrive
REGISTRY_BACKEND=gdrive
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_FOLDER_ID=<id_da_pasta_do_drive>
GOOGLE_SHEET_ID=<id_da_planilha>

# ── Parsing na INGESTÃO (só importa se você rodar --profile ingest) ──────────
# mistral = Mistral OCR (texto) + Gemini Vision (descrição de imagem). NÃO
# depende de Azure. Precisa de MISTRAL_API_KEY + a GOOGLE_API_KEY já definida
# acima. Para só RODAR o bot sobre material JÁ ingerido, isto é irrelevante.
PARSER_BACKEND=mistral
MISTRAL_API_KEY=<sua_chave_mistral>

# ── NÃO defina AZURE_KEY_VAULT_URL aqui ──────────────────────────────────────
# Com ela vazia, o app NÃO tenta Managed Identity do Azure e lê tudo daqui.
