FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Drivers ODBC para Azure SQL (Debian 12 compatible)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl apt-transport-https gnupg2 unixodbc-dev build-essential \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64,armhf,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# O Worker é headless (não expõe porta) e roda scripts python em background
# O WORKER_TYPE é injetado como variável de ambiente no Azure Container Apps
# Pode ser: 'llm', 'scheduler', 'ingestion', 'deletion'
CMD ["sh", "-c", "python -m src.workers.${WORKER_TYPE}_worker"]
