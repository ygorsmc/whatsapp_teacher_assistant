FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instala dependências do SO (se houver, ex: libpq para postgres)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# O Worker é headless (não expõe porta) e roda scripts python em background
# O WORKER_TYPE é injetado como variável de ambiente no Azure Container Apps
# Pode ser: 'llm', 'scheduler', 'ingestion', 'command'
CMD ["sh", "-c", "python -m src.workers.${WORKER_TYPE}_worker"]
