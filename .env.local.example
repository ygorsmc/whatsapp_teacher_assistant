# === PERFIL: LOCAL (Postgres, Redis e Qdrant locais) ===
# Trocar com: make env-local
APP_ENV=local

ENVIRONMENT=development
LOG_LEVEL=INFO

# Meta / WhatsApp Webhook
META_APP_SECRET=<set-me>
META_VERIFY_TOKEN=<set-me>
WHATSAPP_TOKEN=<set-me>
PHONE_NUMBER_ID="1138216092712975"
WHATSAPP_API_URL="https://graph.facebook.com/v25.0"
NGROK_URL="https://7476-2804-7f0-7f01-868e-eb11-4215-b310-e5eb.ngrok-free.app"

# Telegram
TELEGRAM_BOT_TOKEN=<set-me>
CHANNEL_BACKEND="telegram"
SCHEDULER_MODE="buttons"

# Redis
REDIS_URL=redis://localhost:6379/0
DEBOUNCE_TTL_SECONDS=2
MAX_BUFFER_CHARS=4096

# Service Bus
SERVICEBUS_FQDN="your-namespace.servicebus.windows.net"
SERVICEBUS_CONNECTION_STRING=<set-me>

# Qdrant
# Local Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=<set-me>

# Cloud Qdrant (Descomente quando for testar na nuvem)
# QDRANT_URL="https://7ac5a5f6-97db-4a11-beae-fd7a85751a2c.sa-east-1-0.aws.cloud.qdrant.io:6333"
# QDRANT_API_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6ZmVhZGUyNzEtMjVmOS00NWMwLWE2ZTgtNGQxYWYyZGMxNGM0In0.j2fCc5S4j7oASFe4R5EBIi5BDCU0T5KCtpULv8c6QR4"

# Azure Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT="https://whatsapp-ia-assistant.cognitiveservices.azure.com/"
DOCUMENT_INTELLIGENCE_KEY=<set-me>

# DeepSeek / Gemini / Azure Providers
DEFAULT_LLM_PROVIDER="gemini"
DEFAULT_EMBEDDER_PROVIDER="azure"
EMBEDDING_DIMENSIONS=1536

DEEPSEEK_API_KEY=<set-me>
GOOGLE_API_KEY=<set-me>

# Database (Local PostgreSQL via Docker Compose)
DATABASE_URL=postgresql+asyncpg://whatsapp:whatsapp_dev_2026@localhost:5432/whatsapp_assistant

# Fonte de material e cadastro (Ports & Adapters — troca por env var)
#   gdrive (default) = Google Drive/Sheets · local / local_csv = arquivos no disco
MATERIAL_SOURCE_BACKEND=gdrive
REGISTRY_BACKEND=gdrive
# Usados quando MATERIAL_SOURCE_BACKEND=local / REGISTRY_BACKEND=local_csv:
LOCAL_MATERIAL_ROOT="data/materials"   # árvore Curso/Disciplina/[Aulas|Livro|Apostila]/Seção/
LOCAL_REGISTRY_DIR="data/registry"     # Professores.csv, Alunos.csv, Turmas.csv, Chaves.csv

# Google Drive
GOOGLE_DRIVE_FOLDER_ID="1BV5DKoHEp-yWLQ8B7U810wv_b0NACpM2"
GOOGLE_SHEET_ID="1oaaZayqwww9QmKn6R81BJlfV9-XURZZeHYtnLIN1lig"

# Azure Embedding
AZURE_OPENAI_API_KEY=<set-me>
AZURE_OPENAI_ENDPOINT="https://ygorcarvalho-5620-resource.services.ai.azure.com"

# Chart Generation
CHART_GENERATION_ENABLED=false
CHART_RENDERER=none

# ═══════════════════════════════════════════════════════════════════════════
# Paridade com .env.prod — flags, tuning e providers OPCIONAIS.
# Valores = defaults do config.py (flags OFF = comportamento clássico/atual).
# Secrets de providers opcionais ficam VAZIOS → degradam p/ texto/fallback.
# Para testar uma feature localmente, ligue UMA flag por vez (e preencha o
# secret correspondente, se houver).
# ═══════════════════════════════════════════════════════════════════════════

# Segurança Telegram (o setWebhook local deve passar o mesmo secret_token)
TELEGRAM_WEBHOOK_SECRET=<set-me>

# ── RAG de Alta Precisão (F0-F8) — tudo OFF = retriever denso clássico ──
RAGAS_EVAL_ENABLED=false
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_MAX_DOC_CHARS=6000
HYBRID_SEARCH_ENABLED=false
QDRANT_COLLECTION=documents
BGE_M3_ENDPOINT=
BGE_M3_API_KEY=
BGE_M3_TIMEOUT_SECONDS=15.0
RERANKER_PROVIDER=none
RERANK_CANDIDATES=50
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.3
RERANK_TIMEOUT_SECONDS=3.0
RAG_PREFILTER_THRESHOLD=0.2
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-2
OPEN_RERANKER_ENDPOINT=
OPEN_RERANKER_API_KEY=
OPEN_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CRAG_LITE_ENABLED=false
CRAG_GREEN=0.5
CRAG_RED=0.2
LONG_CONTEXT_ENABLED=false
LONG_CONTEXT_MAX_CHARS=150000

# ── Vertical de Matemática (M1-M7) — tudo OFF = parsing/entrega intocados ──
MATH_INGESTION_ENABLED=false
MATH_PARSER_BACKEND=marker
MATH_DENSITY_THRESHOLD=3.0
MATH_MODE_ENABLED=false
MATH_RENDERING_ENABLED=false
MATH_RENDERER=none
MATH_RENDER_ENDPOINT=
MATH_RENDER_API_KEY=
MATH_RENDER_TIMEOUT_SECONDS=15.0
CHART_MAX_POINTS=1000
# Parser ciente de matemática (Marker self-hosted) — sem endpoint → fallback Azure DI
MARKER_ENDPOINT=
MARKER_API_KEY=
MARKER_TIMEOUT_SECONDS=120.0
MARKER_FALLBACK_PARSER=azure

# ── LGPD (P0-P1) ──
LLM_PII_MINIMIZATION=true
GUARDIAN_CONSENT_ENABLED=false
DATA_RETENTION_ENABLED=false
RETENTION_INTERACTION_MONTHS=12
RETENTION_INACTIVE_STUDENT_MONTHS=12

# ── Vertical de Idiomas — tudo OFF = System Prompt bit a bit intocado ──
LANGUAGE_MODE_ENABLED=false
# Áudio de SAÍDA (TTS / listening)
TTS_ENABLED=false
TTS_PROVIDER=azure
TTS_VOICE=pt-BR-FranciscaNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
# Áudio de ENTRADA (STT / speaking) + pronúncia
SPEECH_INPUT_ENABLED=false
STT_PROVIDER=azure
WHISPER_OPENAI_MODEL=whisper-1
WHISPER_ENDPOINT=
WHISPER_API_KEY=
GOOGLE_STT_API_KEY=
PRONUNCIATION_PROVIDER=none
SPEECH_AUDIO_RETENTION_SECONDS=0
# Submodos (ligar aos poucos)
VOCABULARY_SRS_ENABLED=false
ROLEPLAY_ENABLED=false
PLACEMENT_TEST_ENABLED=false
PROFICIENCY_REPORT_ENABLED=false
L1_SAFETY_NET_ENABLED=false
EXAM_PREP_ENABLED=false
# Idiomas padrão
DEFAULT_TARGET_LANGUAGE=en
DEFAULT_NATIVE_LANGUAGE=pt-BR
DEFAULT_CEFR_LEVEL=A2

# ── Gamificação (Fase 0) — tudo OFF = sistema byte a byte idêntico ──
GAMIFICATION_ENABLED=false
XP_LEDGER_ENABLED=false
ANTI_GAMING_ENABLED=false
STREAK_ENABLED=false
STREAK_SHIELD_ENABLED=false
BADGES_ENABLED=false
SECRET_BADGES_ENABLED=false
LEADERBOARD_ENABLED=false
WEEKLY_DIGEST_ENABLED=false
LEAGUES_ENABLED=false
TEACHER_DASHBOARD_ENABLED=false
GRADE_COMPONENT_ENABLED=false
# Pesos de XP + teto diário (calibrar pelo eval/A-B)
XP_QUIZ_CORRECT=10
XP_QUIZ_WRONG=4
XP_SRS_ONTIME=8
XP_READING=5
XP_RAG_DOUBT=3
XP_ESSAY=12
XP_VOICE=10
XP_CONSISTENCY_BONUS=5
XP_DAILY_CAP=70
# Anti-gaming
XP_FLASH_ANSWER_SECONDS=3.0
XP_RAG_DOUBT_DAILY_CAP=3
# Leaderboard / coorte
LEADERBOARD_COHORT_SIZE=30
GAMIFICATION_MIN_COHORT=3
# Resumo semanal (0=segunda … 6=domingo; hora BRT)
WEEKLY_DIGEST_WEEKDAY=6
WEEKLY_DIGEST_HOUR=18
# Ligas (Fase 1): topo que sobe / fundo que desce por coorte
LEAGUE_PROMOTE_TOP=5
LEAGUE_RELEGATE_BOTTOM=5
