FROM python:3.12-slim

# Evita que o Python grave arquivos .pyc no disco (melhor performance no container)
ENV PYTHONDONTWRITEBYTECODE=1
# Garante que as mensagens de stdout/stderr não fiquem em buffer (logs em tempo real)
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instala dependências do SO (se houver, ex: libpq para postgres)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Expõe a porta fornecida pelo ambiente (Padrão 80)
ENV PORT=80
EXPOSE $PORT

# Comando para iniciar o Webhook (O KEDA escalará este container)
CMD ["sh", "-c", "exec uvicorn src.webhook.main:app --host 0.0.0.0 --port $PORT"]
